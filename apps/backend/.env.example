# Copy to apps/backend/.env and adjust. Never commit the real .env.
# Both the NestJS app and the Prisma CLI load this file (run from apps/backend).

# --- Runtime ---
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# --- Geocoding (private Photon service) ---
PHOTON_URL=http://127.0.0.1:2322
PHOTON_TIMEOUT_MS=5000

# --- Routing (private Valhalla service) ---
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_MS=10000

# --- Database (Postgres) ---
# docker-compose maps Postgres to host port 5433 (avoids clashing with a local 5432).
DATABASE_URL=postgresql://bigant:bigant@localhost:5433/bigant_logistics?schema=public

# --- Redis (used by the background worker from Phase 1) ---

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- Scheduling ---
# Window (minutes, before/after) used to warn about driver prebooking conflicts.
SCHEDULE_CONFLICT_WINDOW_MINUTES=90

# --- Photo storage ---
# Default: this machine's disk, served by the API at http://localhost:3000/media.
MEDIA_DIR=./media
# MEDIA_PUBLIC_URL=http://192.168.1.10:3000/media   # e.g. for a phone on the LAN
# Optional S3-compatible store (Garage, SeaweedFS, AWS S3, R2) instead of the disk:
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Cloudinary (proof photo uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# public_id of the watermark overlay asset (folders allowed; leave empty to disable watermarking)
CLOUDINARY_WATERMARK_ID=

# --- Fuel log: reading the dispenser photo (optional) ---
# Leave the key empty and drivers type the numbers themselves. With a key, the
# review screen comes prefilled and blurred photos get a retake prompt.
OPENAI_API_KEY=
# gpt-4.1-mini reads seven-segment displays well at ~$0.001 per photo;
# gpt-4.1-nano is ~4x cheaper and worth trying once there is a month of data.
OPENAI_VISION_MODEL=gpt-4.1-mini
# Google Gemini reads the same photos and has a free tier (key from
# aistudio.google.com, no card). Used when OPENAI_API_KEY is empty.
# gemini-3.5-flash-lite answered in ~2 s on a test display; gemini-3.6-flash
# took 12-18 s (it thinks first), so raise FUEL_AI_TIMEOUT_MS if you pick it.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
FUEL_AI_TIMEOUT_MS=15000

# --- Notifications (push) ---
# Firebase service account (JSON string or path). Empty = push is logged, not sent.
FIREBASE_SERVICE_ACCOUNT=

# --- Telegram proof reports ---
# Bot token + target group chat id. Empty = sends are logged, not delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_VOZRAT_GROUP_ID=
TELEGRAM_PICKUP_GROUP_ID=
TELEGRAM_FUEL_GROUP_ID=
TELEGRAM_SERVICE_GROUP_ID=

# --- Background worker (transactional outbox dispatcher) ---
WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000

# --- Seed admin (created by `pnpm db:seed`) ---
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=admin12345

# Vozvrat mini app (Telegram): where the driver's returns go and where the
# product catalogue comes from. Reports wait until both are set; the mini app
# refuses keys under 32 characters. The products URL defaults to
# …/api/tashqi/mahsulotlar next to the report URL.
VOZVRAT_API_URL=
VOZVRAT_API_KEY=
# VOZVRAT_PRODUCTS_URL=
# VOZVRAT_PRODUCTS_TTL_MS=600000
