# Copy to deploy/.env.prod on the server and fill in. NEVER commit the real file.
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# Generate every secret below with:
#   openssl rand -hex 32

# --- Public identity ---
DOMAIN=your-domain.uz
# Directory on the host holding origin.pem and origin.key (mounted read-only).
CERT_DIR=/etc/bigant/certs

# Where the PMTiles basemap lives on the host. Rebuilt with planetiler; see
# the Map tiles section of deploy/README.md.
TILES_DIR=/opt/bigant-geo/tiles
# Directory of credential files, mounted read-only at /run/secrets in the API
# container. Put firebase-service-account.json here (chmod 600).
SECRETS_DIR=/etc/bigant/secrets

# --- Database ---
POSTGRES_USER=bigant
POSTGRES_DB=bigant_logistics
# Not published to the host, but it is still the last line of defence.
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth ---
# Anyone holding these can mint an admin token. Rotating them invalidates every
# issued access and refresh token, which is the intended effect.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- CORS ---
# Leave EMPTY. The dashboard is served from the same origin as /api and the
# mobile app is native, so no browser makes a cross-origin request. Set it only
# if the dashboard ever moves to a different hostname.
CORS_ORIGINS=

# --- Private geocoding service ---
PHOTON_URL=http://photon:2322
PHOTON_TIMEOUT_MS=5000

# --- Private routing service ---
VALHALLA_URL=http://valhalla:8002
VALHALLA_TIMEOUT_MS=10000

# --- Background worker ---
# Exactly one instance may run these dispatchers, or outbox events double-send.
WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
SCHEDULE_CONFLICT_WINDOW_MINUTES=90
ASSIGNMENT_TIMEOUT_MINUTES=10

# --- Telegram (proof reports) ---
# Use a SEPARATE bot and separate groups from development, or your dev machine
# and this server will both post into the groups real drivers are reading.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_VOZRAT_GROUP_ID=
TELEGRAM_PICKUP_GROUP_ID=
# The dispenser photo of every confirmed fill-up, and a service visit's work
# photos and receipt as one album. Empty = the report is queued, never sent.
TELEGRAM_FUEL_GROUP_ID=
TELEGRAM_SERVICE_GROUP_ID=
# Where the server's own alerts go — disk, memory, a container that died. Falls
# back to TELEGRAM_GROUP_CHAT_ID, but a separate chat keeps ops noise out of the
# group people use for work.
TELEGRAM_OPS_CHAT_ID=

# --- Backups ---------------------------------------------------------------
# rsync destination for the copy that leaves this host, e.g.
# backup@elsewhere:/backups/bigant/. Empty means every dump sits on the same
# disk as the database it protects.
OFFSITE_TARGET=
OFFSITE_SSH_KEY=/root/.ssh/backup_key
# Dead-man's switch pinged after a successful backup (healthchecks.io or
# similar). The failure worth catching is the backup quietly stopping, and only
# something expecting a regular ping can notice that.
PING_URL=

# --- Proof photos ---
# Host directory the API writes photos to; nginx serves it at https://$DOMAIN/media.
# Photos are shrunk to 1600px (~200 KB each) before they are saved.
MEDIA_DIR=/var/lib/bigant/media
# Where the driver app's over-the-air updates live. Written by
# tools/publish-update.sh, served read-only by nginx at /updates/.
UPDATES_DIR=/var/lib/bigant/updates

# --- Cloudinary (optional alternative to the disk; leave empty) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WATERMARK_ID=

# --- Fuel log: reading the dispenser photo (optional) ---
# Empty key: drivers type the numbers. Also add it to docker-compose.prod.yml's
# environment list if you ever move it — compose forwards variables by name.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Google Gemini (aistudio.google.com/apikey, free tier) — used when the OpenAI
# key is empty. gemini-3.5-flash-lite reads a display in 2-5 s.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
FUEL_AI_TIMEOUT_MS=30000

# --- Omborchi (warehouse page, owner 05.11.2026) ---
# The mini app's bot token (@bigant_innovation_bot): signs the storekeepers in
# on https://<DOMAIN>/ombor and sends them the returns. Only in the server's .env.
VOZVRAT_BOT_TOKEN=

# --- Driver app updates: test phones first (owner, 09.11.2026) ---
# Sinov telefonlari: shu foydalanuvchilar (users.id, vergul bilan) yangi
# yangilanishni birinchi oladi. tools/publish-update.sh faqat ularga yuboradi;
# egasi tekshirgach tools/promote-update.sh hammaga chiqaradi.
# Bo'sh = sinov telefoni yo'q (yangilanish `test`da kutib turadi).
# Masalan: OTA_TESTER_USER_IDS=3f2a...-uuid,9b1c...-uuid
OTA_TESTER_USER_IDS=

# --- Push notifications (FCM) ---
# Path INSIDE the container. Place the file at $SECRETS_DIR on the host; it is
# mounted read-only at /run/secrets. Inline JSON also works (push.sender.ts
# accepts either), but a file keeps the private key out of `docker inspect`.
# Leave empty to disable push — the app logs instead of sending.
FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
# iPhone push (Apple APNs) — from the Apple Developer account: Keys → "+" with
# Apple Push Notifications service. The .p8 file goes to $SECRETS_DIR/apns.p8.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.bigant.driver
APNS_PRODUCTION=true

# --- First admin (created by `pnpm db:seed`) ---
# Used once to bootstrap login. Change the password after the first sign-in.
# Quoted because it contains a space: Compose tolerates it bare, but any tool
# that sources this file as shell would treat "Admin" as a command.
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=CHANGE_ME
