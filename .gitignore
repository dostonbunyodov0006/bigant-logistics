# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.nest/
*.tsbuildinfo

# Turbo
.turbo/

# Env
.env
.env.local
.env.*.local
# Production secrets — the `.env` pattern above does NOT match these.
.env.prod
.env.production

# TLS private keys and certificates (deployment)
deploy/certs/
*.pem
*.key
!**/*.pub

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / tests
coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma
logistics/apps/backend/prisma/*.db

# Generated OpenAPI spec (regenerate with `pnpm --filter @bigant/backend openapi:export`)
logistics/apps/backend/openapi.json

# Firebase service account (credentials — never commit)
firebase-service-account.json

# Expo / RN
.expo/
*.keystore
*.jks
# Generated by `expo prebuild` — regenerate it, never edit or commit it.
logistics/apps/mobile/android/
logistics/apps/mobile/ios/
# Firebase Android config: carries the project's API key and app id. Belongs on
# the builder's machine, not in the repo — it can be re-fetched from the Firebase
# Management API with the backend service account.
google-services.json

# Proof photos stored on disk (MEDIA_DIR) — data, not source
logistics/apps/backend/media/

# Mobile build and keys
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
media/
